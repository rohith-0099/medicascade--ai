# ═══════════════════════════════════════════════════════════════
#  MediCascade AI — Environment Template
#  Copy this file to .env and fill in real values.
#  Add .env to .gitignore — NEVER commit secrets.
# ═══════════════════════════════════════════════════════════════

# ── HuggingFace (REQUIRED) ─────────────────────────────────────
HF_API_TOKEN=
HUGGINGFACE_TOKEN=

# ── HF Inference API URLs ──────────────────────────────────────
HF_CHAT_URL=https://router.huggingface.co/v1/chat/completions
HF_INFERENCE_URL=https://router.huggingface.co/hf-inference/models
HF_BASE_URL=https://router.huggingface.co/models

# ── Model Overrides (all optional) ────────────────────────────
# HF_IMAGING_MODEL=google/medgemma-4b-it
# HF_SYMPTOM_MODEL=UFNLP/gatortron-medium
# HF_LAB_MODEL=google/medgemma-4b-it
# HF_LITERATURE_MODEL=microsoft/BioGPT-Large
# HF_RISK_LM_MODEL=MaziyarPanahi/OpenMed-SuperClinical-434M
# HF_VALIDATOR_MODEL=google/medgemma-4b-it
# HF_EXPLAINER_MODEL=google/medgemma-4b-it

# ── Ollama (optional local fallback) ──────────────────────────
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# ── Gemini (optional XAI fallback) ────────────────────────────
GEMINI_API_KEY=

# ── Storage ───────────────────────────────────────────────────
UPLOAD_DIR=uploads
OUTPUT_DIR=outputs
