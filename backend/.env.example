# MediCascade AI — environment template
# Copy to backend/.env and fill in real values. Keep .env out of git.

# ── Providers ─────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_VALIDATOR_MODEL=meta-llama/llama-3.3-70b-instruct:free

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Vision (optional; required if you want MedGemma OCR/imaging)
HF_API_TOKEN=
HF_VISION_MODEL=google/medgemma-4b-it

# ── Storage ───────────────────────────────
UPLOAD_DIR=uploads
OUTPUT_DIR=outputs
CASE_DIR=outputs/cases
MAX_UPLOAD_SIZE=52428800

# ── Ollama (optional: offline/local fallback) ─────────
# Start: ollama serve && ollama pull llama3.2
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ── Database ──────────────────────────────────────────
DB_PATH=outputs/medicascade.db

# ── Logging / timeouts ─────────────────────
LOG_LEVEL=INFO
LAYER1_TIMEOUT=90
LAYER2_TIMEOUT=120
LAYER3_TIMEOUT=90
MRI_USE_HDBET=true
